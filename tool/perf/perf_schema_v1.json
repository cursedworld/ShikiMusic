{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shikimusic.local/perf_schema_v1.json",
  "title": "ShikiMusic performance run",
  "type": "object",
  "required": ["schemaVersion", "metadata", "measurement", "scenarios"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "metadata": {
      "type": "object",
      "required": ["commit", "platform", "buildMode", "flutterVersion"],
      "properties": {
        "commit": { "type": "string", "minLength": 1 },
        "platform": { "enum": ["windows", "linux", "android"] },
        "buildMode": { "enum": ["profile", "release"] },
        "flutterVersion": { "type": "string", "minLength": 1 },
        "os": { "type": "string" },
        "device": { "type": "string" },
        "cpu": { "type": "string" },
        "gpu": { "type": "string" },
        "driver": { "type": "string" },
        "videoBackend": { "type": "string" },
        "decoder": { "type": "string" },
        "decoderEvidence": { "type": "string" },
        "fixtureHashes": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "measurement": {
      "type": "object",
      "required": ["measuredRuns", "sampleIntervalMs"],
      "properties": {
        "warmupRuns": { "type": "integer", "minimum": 0 },
        "measuredRuns": { "type": "integer", "minimum": 3 },
        "sampleIntervalMs": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "metrics"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "metrics": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "samples": {
                  "type": "array",
                  "items": { "type": "number" }
                },
                "median": { "type": "number" },
                "p95": { "type": "number" },
                "compareStat": { "enum": ["median", "p95"] },
                "required": { "type": "boolean" },
                "requiredEvidence": { "type": "boolean" },
                "evidence": { "type": "string" },
                "maxRegressionPercent": { "type": "number", "minimum": 0 },
                "maxAbsolute": { "type": "number", "minimum": 0 },
                "target": { "type": "number", "minimum": 0 },
                "failureAbove": { "type": "number", "minimum": 0 }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
